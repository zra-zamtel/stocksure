DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for SQLite in development. For PostgreSQL:
# DATABASE_URL=postgres://stocksure:password@localhost:5432/stocksure
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Integrations (all mocked by default; swap the dotted path to go live later)
SMS_BACKEND=apps.integrations.sms.ConsoleSMSBackend
AI_INVOICE_READER=apps.integrations.ai.MockInvoiceReader
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ZAMTEL_WEBHOOK_SECRET=dev-webhook-secret
USSD_SHARED_SECRET=
ALLOW_PAYMENT_SIMULATION=True
