DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for SQLite in development. PostgreSQL example:
# DATABASE_URL=postgres://stocksure:stocksure@localhost:5432/stocksure
DATABASE_URL=

# SMS for PIN-reset codes. Console just logs the message (no real SMS).
SMS_BACKEND=apps.core.sms.ConsoleSMSBackend
# Dev only: include the PIN-reset code in the API response so you can test without SMS.
PIN_RESET_RETURN_CODE=True

# Africa's Talking USSD callback. Set a secret in production and send it as X-USSD-Secret.
USSD_SHARED_SECRET=
