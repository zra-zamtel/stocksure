# Copy this file to backend/.env and edit the values for your machine.
# backend/.env is git-ignored; never commit real credentials.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS/Linux:         cp .env.example .env
#
# The defaults are safe: debug and demo token exposure are off, and the secret
# key is empty so the server refuses to start until one is set. For a throwaway
# local demo, see the commented block below.

# --- Django ---------------------------------------------------------------
# Use 0 on any deployed server. 1 is only for a local machine.
DJANGO_DEBUG=0

# Required when DJANGO_DEBUG=0. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Required when DJANGO_DEBUG=0. Comma-separated public host names.
# Leave empty during local development: debug mode allows all hosts.
DJANGO_ALLOWED_HOSTS=

# Never enable these on a deployed server: they return one-time tokens in API
# responses instead of sending them by email or SMS.
EXPOSE_EMAIL_TOKEN=0
EXPOSE_RESET_CODE=0

# --- Local demo only ------------------------------------------------------
# Uncomment for a throwaway demo machine where the app shows the magic link and
# reset code on screen. Debug mode also generates a development secret key when
# DJANGO_SECRET_KEY is empty. Never use these values on a deployed server.
# DJANGO_DEBUG=1
# EXPOSE_EMAIL_TOKEN=1
# EXPOSE_RESET_CODE=1
# DJANGO_ALLOWED_HOSTS=*

# --- Email (SMTP) ---------------------------------------------------------
# Leave EMAIL_HOST empty to print magic links to the Django console.
#
# Project choice: Gmail. Set EMAIL_HOST=smtp.gmail.com, keep port 587 and TLS
# on, put the full Gmail address in EMAIL_HOST_USER, and use a 16-character
# App Password (Google Account -> Security -> App passwords). Keep
# DJANGO_DEFAULT_FROM_EMAIL on the same address.
# Brevo: smtp-relay.brevo.com, port 587, TLS on. USER is your Brevo login
# (usually the account email) and PASSWORD is the SMTP key.
# SES:   email-smtp.<region>.amazonaws.com, port 587, TLS on.
# For port 465, set EMAIL_USE_SSL=1 and EMAIL_USE_TLS=0 (never both).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL="StockSure <no-reply@example.com>"

# The deep link the email opens. Keep the app scheme unless it changes.
MAGIC_LINK_BASE_URL=stocksure://magic-link

# --- Database -------------------------------------------------------------
# Leave empty for SQLite at backend/db.sqlite3. For a managed Postgres
# (Neon, Supabase, Railway, Render), paste its connection string:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
#
# The hosted StockSure project uses a dedicated "stocksure" schema (not the
# public schema) and the "stocksure_app" role, whose default search_path is
# "stocksure, public". That keeps the auth tables out of Supabase's public
# PostgREST API. Ask the project owner for the app connection string.
DATABASE_URL=

# 0 is safest for serverless Postgres such as Neon. Use 600 on a long-running
# server if you want connection reuse.
DB_CONN_MAX_AGE=0

# Set to 1 only when using Supabase's transaction pooler (port 6543). The
# session pooler and direct connections do not need it.
DB_DISABLE_SERVER_SIDE_CURSORS=0

# --- API and integrations (Django domain backend) -------------------------
# Browser origins allowed to call the API when DEBUG is off. Comma-separated.
CORS_ALLOWED_ORIGINS=

# Every external service sits behind a dotted-path backend so a real one can
# plug in later. The defaults are local mocks.
SMS_BACKEND=apps.integrations.sms.ConsoleSMSBackend
AI_INVOICE_READER=apps.integrations.ai.MockInvoiceReader
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Local-demo values. Replace both with strong secrets before exposing the API.
ZAMTEL_WEBHOOK_SECRET=local-demo-webhook-secret
USSD_SHARED_SECRET=local-demo-ussd-secret

# 1 turns on the demo "simulate a mobile-money payment" action. Never 1 on a
# deployed server.
ALLOW_PAYMENT_SIMULATION=1
PAYMENT_MATCH_WINDOW_MINUTES=120
